{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["expo-router"],           // IMPORTANTE
    "paths": { "~/*": ["./*"] }
  },
  "include": [
    "app", "expo-env.d.ts", "app.config.ts",
    "**/*.ts", "**/*.tsx",               // garanta que pega seus .ts/.tsx
    ".expo/types/**/*.ts"                // inclui os tipos gerados
  ]
}
